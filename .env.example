# --- Soroban / KoboDial contract -------------------------------------------
# The Stellar RPC endpoint. Use a public testnet endpoint for development;
# point at a provider URL for mainnet.
RPC_URL=https://soroban-testnet.stellar.org

# The deployed KoboDial contract ID (starts with C...).
CONTRACT_ID=

# The Soroban network passphrase must match the network RPC_URL serves.
# Testnet default shown; override for mainnet or a local quickstart node.
NETWORK_PASSPHRASE=Test SDF Network ; September 2015

# The relayer's own Soroban secret key (starts with S...). This account
# signs and submits every transaction the gateway sends, and must be the
# same address the contract was deployed with --admin, since register,
# fund and cash_out require that admin's authorization.
#
# This key is the gateway's crown jewel: whoever holds it can submit
# register/fund/cash_out calls and pay the network fees for every relayed
# send and change_pin. It never authorizes moving a USER's funds by
# itself — that still requires the user's correct PIN and exact nonce,
# checked on-chain — but losing it means losing the ability to run the
# service at all, and possibly having someone else run it as you.
# NEVER commit a real value here.
RELAYER_SECRET_KEY=

# --- Database ----------------------------------------------------------------
# SQLite file path (relative or absolute) for development. See src/db for
# swapping to Postgres.
DATABASE_URL=file:./kobodial-gateway.sqlite

# --- Africa's Talking --------------------------------------------------------
# Sandbox credentials from https://account.africastalking.com — the sandbox
# app is free and does not require short-code registration.
AFRICAS_TALKING_USERNAME=sandbox
AFRICAS_TALKING_API_KEY=

# --- Server ------------------------------------------------------------------
PORT=3000
LOG_LEVEL=info
